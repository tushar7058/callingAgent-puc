# Version control and CI metadata
.git/
.github/
.gitignore
.gitattributes

# Local environments and editor state
.venv/
venv/
.idea/
.vscode/
.DS_Store

# Python artifacts and caches
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.pytest_cache/
.ruff_cache/
.cache/
dist/
build/
coverage/

# Runtime/generated project data
src/__pycache__/
src/**/__pycache__/
src/.livekit/
src/data/
src/logs/
src/livekit_agent.egg-info/

# Tests are validated before the image is built and are not needed at runtime
src/tests/
test/
tests/
eval/
evals/

# Secrets and local env files are mounted at deploy time
.env
.env.*
key.json

# Documentation and local assistant metadata
.agents/
.claude/
AGENTS.md
CLAUDE.md
GEMINI.md
README.md
LICENSE

# Logs and archives
*.log
*.gz
*.tgz
*.tmp
